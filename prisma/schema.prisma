// Prisma schema for the Pemaro inventory server (Neon Postgres).
//
// Conventions
// - Primary keys are UUIDs generated by Postgres (gen_random_uuid()).
// - Money is Decimal(12,2); never Float.
// - Timestamps are timestamptz. The API formats them as dd/MM/yyyy in
//   APP_TIMEZONE for the frontend.
// - Columns and tables are snake_case via @map / @@map.
// - Rows people may still reference (products, expenses) are soft-deleted
//   with deleted_at instead of being removed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

enum Role {
  ADMIN
  STAFF
  SUPPORT
}

enum PaymentMethod {
  CASH
  AIRTEL_MONEY
  MTN_MOBILE_MONEY
  VISA_CARD
  GLOVO
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum ExpenseStatus {
  ACTIVE
  VOID
}

enum StockMovementType {
  RESTOCK // stock received
  SALE // stock sold (negative quantity)
  ADJUSTMENT // manual correction (+/-)
}

// ---------------------------------------------------------------- people

model User {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String    @unique
  password    String
  surname     String?
  otherNames  String?   @map("other_names")
  avatar      String?
  gender      String?
  birthDate   DateTime? @map("birth_date") @db.Date
  address     String?
  phoneNumber String?   @map("phone_number")
  role        Role      @default(STAFF)
  isActive    Boolean   @default(true) @map("is_active")
  // Tokens issued before this moment are rejected (set on password change/reset).
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sales            Sale[]
  expenses         Expense[]       @relation("ExpenseRecordedBy")
  productsCreated  Product[]       @relation("ProductCreatedBy")
  stockMovements   StockMovement[]
  passwordResets   PasswordResetToken[]

  @@map("users")
}

// Single-use "forgot password" tokens. Only a SHA-256 hash is stored, so a
// database leak can't be used to reset passwords.
model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------- catalogue

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  subCategories SubCategory[]

  @@map("categories")
}

model SubCategory {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  name       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([categoryId, name])
  @@map("sub_categories")
}

model Product {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  artNumber       String    @unique @map("art_number") // WD1, WD2, ... from the counters table
  name            String
  description     String?
  subCategoryId   String    @map("sub_category_id") @db.Uuid
  purchasingPrice Decimal   @default(0) @map("purchasing_price") @db.Decimal(12, 2)
  sellingPrice    Decimal   @map("selling_price") @db.Decimal(12, 2)
  imageUrl        String?   @map("image_url")
  // null = stock not tracked for this product (e.g. made-to-order food)
  stockQuantity   Int?      @map("stock_quantity")
  isActive        Boolean   @default(true) @map("is_active")
  createdById     String?   @map("created_by_id") @db.Uuid
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  subCategory    SubCategory      @relation(fields: [subCategoryId], references: [id], onDelete: Restrict)
  createdBy      User?            @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  variants       ProductVariant[]
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@index([subCategoryId])
  @@map("products")
}

model ProductVariant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  size      String?
  color     String?
  quantity  Int      @default(0) // current stock; changed only together with a StockMovement

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@unique([productId, size, color])
  @@index([productId])
  @@map("product_variants")
}

// Every stock change, so quantities can be audited and rebuilt.
model StockMovement {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String            @map("product_id") @db.Uuid
  variantId  String?           @map("variant_id") @db.Uuid
  saleItemId String?           @unique @map("sale_item_id") @db.Uuid
  type       StockMovementType
  quantity   Int // positive = in, negative = out
  note       String?
  userId     String?           @map("user_id") @db.Uuid
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  product  Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  saleItem SaleItem?       @relation(fields: [saleItemId], references: [id], onDelete: SetNull)
  user     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([variantId])
  @@map("stock_movements")
}

// ---------------------------------------------------------------- sales

// One checkout / receipt.
model Sale {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptNo     Int           @unique @map("receipt_no") // from the counters table
  userId        String        @map("user_id") @db.Uuid
  paymentMethod PaymentMethod @map("payment_method")
  status        SaleStatus    @default(COMPLETED)
  paymentStatus PaymentStatus @default(PAID) @map("payment_status")
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12, 2)
  amountPaid    Decimal       @map("amount_paid") @db.Decimal(12, 2)
  amountDue     Decimal       @default(0) @map("amount_due") @db.Decimal(12, 2)
  soldAt        DateTime      @default(now()) @map("sold_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  items SaleItem[]

  @@index([soldAt])
  @@index([userId, soldAt])
  @@map("sales")
}

// One product line on a receipt. Name, art number and price are copied at
// the time of sale so later product edits never rewrite history.
model SaleItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId      String   @map("sale_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  variantId   String?  @map("variant_id") @db.Uuid
  productName String   @map("product_name")
  artNumber   String   @map("art_number")
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sale          Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  stockMovement StockMovement?

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

// ---------------------------------------------------------------- expenses

model ExpenseCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ref         String        @unique // PT001, PT002, ... from the counters table
  categoryId  String        @map("category_id") @db.Uuid
  amount      Decimal       @db.Decimal(12, 2)
  description String?
  status      ExpenseStatus @default(ACTIVE)
  spentAt     DateTime      @default(now()) @map("spent_at") @db.Timestamptz(3)
  userId      String        @map("user_id") @db.Uuid
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  user     User            @relation("ExpenseRecordedBy", fields: [userId], references: [id], onDelete: Restrict)

  @@index([spentAt])
  @@index([userId, spentAt])
  @@index([categoryId])
  @@map("expenses")
}

// ---------------------------------------------------------------- system

// Atomic sequences for human-readable codes (receipt numbers, WD/PT codes).
model Counter {
  key   String @id
  value Int    @default(0)

  @@map("counters")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}

// `list` is the `sheet` value the frontend sends (e.g. "Kisyanga Subscriptions").
model Subscriber {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String
  list      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([email, list])
  @@map("subscribers")
}

model ContactMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String?
  email     String?
  subject   String?
  message   String?
  list      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([list, createdAt])
  @@map("contact_messages")
}
