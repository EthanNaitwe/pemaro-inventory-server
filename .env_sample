PORT=5000
# Business timezone used to format sale/expense dates (dd/MM/yyyy)
APP_TIMEZONE=Africa/Kampala
JWT_SECRET=

# Neon Postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Used by `npm run db:seed` (a random password is generated if left empty)
ADMIN_EMAIL=admin@pemaro.local
ADMIN_PASSWORD=
ADMIN_SURNAME=Admin
ADMIN_OTHER_NAMES=Pemaro

# Password reset emails (SMTP via Nodemailer). Leave SMTP_HOST empty in
# development to print reset links to the server console instead.
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Pemaro Inventory <no-reply@example.com>"
